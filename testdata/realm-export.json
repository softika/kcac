{
  "realm": "kcac-test",
  "enabled": true,
  "sslRequired": "none",
  "eventsEnabled": false,
  "adminEventsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "base-employee",
        "description": "leaf role, reached only through composites"
      },
      {
        "name": "till-supervisor",
        "description": "composite containing another composite",
        "composite": true,
        "composites": {
          "realm": [
            "base-employee"
          ]
        }
      },
      {
        "name": "store-admin",
        "description": "composite containing a realm composite AND a client role",
        "composite": true,
        "composites": {
          "realm": [
            "till-supervisor"
          ],
          "client": {
            "pos-app": [
              "till-operator"
            ]
          }
        }
      },
      {
        "name": "regional-manager",
        "description": "top of the three-hop composite chain",
        "composite": true,
        "composites": {
          "realm": [
            "store-admin"
          ]
        }
      },
      {
        "name": "orphan-role",
        "description": "exists but is assigned to nobody"
      }
    ],
    "client": {
      "crm-app": [
        {
          "name": "viewer"
        }
      ],
      "pos-app": [
        {
          "name": "till-operator",
          "description": "leaf client role"
        },
        {
          "name": "till-admin",
          "description": "client composite containing a client role",
          "composite": true,
          "composites": {
            "client": {
              "pos-app": [
                "till-operator"
              ]
            }
          }
        }
      ]
    }
  },
  "groups": [
    {
